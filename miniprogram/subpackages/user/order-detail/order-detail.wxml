<view class="order-detail-page">
  <t-loading wx:if="{{loading}}" theme="circular" size="40px" text="加载中..." />
  <view wx:elif="{{loadError}}" class="error-wrap">
    <text class="error-text">加载失败</text>
    <t-button size="small" bindtap="loadDetail">重试</t-button>
  </view>

  <view wx:elif="{{order}}" class="detail-content">
    <!-- 状态标签 -->
    <view class="status-bar">
      <t-tag theme="{{statusTheme}}" size="large">{{ORDER_STATUS_MAP[order.status]}}</t-tag>
    </view>

    <!-- 订单信息 -->
    <t-cell-group bordered>
      <t-cell title="订单号" note="{{order.orderNo}}" />
      <t-cell title="服务标题" note="{{order.shelfTitle}}" />
      <t-cell title="积分金额" note="{{order.pointAmount}} 积分" />
      <t-cell wx:if="{{order.tagName}}" title="分类" note="{{order.tagName}}" />
      <t-cell title="创建时间" note="{{order.createTimeFormatted}}" />
    </t-cell-group>

    <!-- 对方信息 -->
    <t-cell-group bordered>
      <t-cell title="{{order.myRole === 'seller' ? '买家' : '卖家'}}" note="{{order.myRole === 'seller' ? order.buyerNickname : order.sellerNickname}}" />
    </t-cell-group>

    <!-- 无权限提示 -->
    <view wx:if="{{order.myRole === null}}" class="code-section">
      <text class="code-hint">当前订单与你无关，无法查看核销码或操作</text>
    </view>

    <!-- ====== Status 1: 待核销 — 启动核销码 ====== -->
    <view wx:elif="{{order.status === 1}}" class="code-section">
      <view class="section-title">启动服务核销码</view>
      <view class="code-row">
        <view class="code-box">
          <text class="code-label">买家核销码</text>
          <text class="code-text">{{order.startBuyerCode}}</text>
        </view>
        <view class="code-box">
          <text class="code-label">卖家核销码</text>
          <text class="code-text">{{order.startSellerCode}}</text>
        </view>
      </view>
      <view class="code-hint">双方均输入对方的核销码后，订单进入服务中状态</view>
      <view class="verify-status">
        <text>买家：{{order.buyerVerified ? '已核销' : '待核销'}}</text>
        <text>卖家：{{order.sellerVerified ? '已核销' : '待核销'}}</text>
      </view>
    </view>

    <!-- ====== Status 3: 服务中 — 确认核销码 ====== -->
    <view wx:elif="{{order.status === 3}}" class="code-section">
      <view class="section-title">完成服务确认码</view>
      <view class="code-row">
        <view class="code-box">
          <text class="code-label">买家确认码</text>
          <text class="code-text">{{order.completeBuyerCode}}</text>
        </view>
        <view class="code-box">
          <text class="code-label">卖家确认码</text>
          <text class="code-text">{{order.completeSellerCode}}</text>
        </view>
      </view>
      <view class="code-hint">双方均输入对方的确认码后，订单完成并结算积分</view>
      <view class="verify-status">
        <text>买家：{{order.buyerConfirmed ? '已确认' : '待确认'}}</text>
        <text>卖家：{{order.sellerConfirmed ? '已确认' : '待确认'}}</text>
      </view>
    </view>

    <!-- ====== Status 7: 争议中 ====== -->
    <view wx:elif="{{order.status === 7}}" class="code-section">
      <view class="section-title">争议处理中</view>
      <text class="code-hint">订单存在争议，平台客服正在介入处理，请保持沟通渠道畅通</text>
    </view>

    <!-- 退款提示 -->
    <view wx:if="{{order.refundRequesting}}" class="refund-banner">
      <t-icon name="error-circle" size="40rpx" color="#FF6E14" />
      <text>{{order.refundRequester === order.myRole ? '你' : (order.refundRequester === 'buyer' ? '买家' : '卖家')}}已发起退款申请</text>
    </view>

    <!-- 时间线 -->
    <view wx:if="{{order.serviceStartTime}}" class="timeline">
      <text class="timeline-item">开始: {{order.serviceStartTime}}</text>
      <text wx:if="{{order.completeTime}}" class="timeline-item">完成: {{order.completeTime}}</text>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view wx:if="{{order}}" class="bottom-actions">
    <!-- Status 1: 买家先支付积分 -->
    <t-button wx:if="{{order.myRole === 'buyer' && order.status === 1}}" theme="primary" size="large" block loading="{{actionLoading}}" bindtap="onPayOrder">立即支付</t-button>

    <!-- Status 1: 输入对方核销码启动服务 -->
    <t-button wx:if="{{order.myRole && order.status === 1}}" theme="primary" size="large" block loading="{{actionLoading}}" bindtap="onCodeBtnTap" data-title="输入对方的核销码" data-action="start">核销启动服务</t-button>

    <!-- Status 3: 输入对方确认码完成服务 -->
    <t-button wx:if="{{order.myRole && order.status === 3}}" theme="primary" size="large" block loading="{{actionLoading}}" bindtap="onCodeBtnTap" data-title="输入对方的确认码" data-action="complete">核销完成服务</t-button>

    <!-- Status 5: 去评价 -->
    <t-button wx:if="{{order.myRole && order.status === 5 && !reviewed}}" theme="primary" size="large" block loading="{{actionLoading}}" bindtap="onShowReviewDialog">去评价</t-button>

    <!-- Status 3/5: 争议 -->
    <t-button wx:if="{{order.myRole && (order.status === 3 || order.status === 5)}}" theme="warning" size="large" block loading="{{actionLoading}}" bindtap="onShowDisputeDialog">发起争议</t-button>

    <!-- Status 3: 申请退款（仅未发起时） -->
    <t-button wx:if="{{order.myRole && order.status === 3 && !order.refundRequesting}}" theme="light" size="large" block loading="{{actionLoading}}" bindtap="onRequestRefund">申请退款</t-button>

    <!-- Status 3: 同意退款（仅对方发起时） -->
    <t-button wx:if="{{order.myRole && order.status === 3 && order.refundRequesting && order.refundRequester !== order.myRole}}" theme="danger" size="large" block loading="{{actionLoading}}" bindtap="onApproveRefund">同意对方退款</t-button>

    <!-- Status 3: 等待对方同意（己方发起时） -->
    <t-button wx:if="{{order.myRole && order.status === 3 && order.refundRequesting && order.refundRequester === order.myRole}}" theme="light" size="large" block disabled>等待对方同意退款</t-button>

    <!-- Status 1: 卖家可单方面取消 -->
    <t-button wx:if="{{order.myRole === 'seller' && order.status === 1}}" theme="default" size="large" block loading="{{actionLoading}}" bindtap="onShowCancelDialog">取消订单</t-button>
  </view>

  <!-- 核销码弹窗 -->
  <t-dialog visible="{{showCodeDialog}}" title="{{codeDialogTitle}}" confirm-btn="确认" cancel-btn="取消" bind:confirm="onConfirmCode" bind:cancel="onCloseCodeDialog">
    <input slot="content" class="code-input" placeholder="请输入核销码" value="{{codeInput}}" bindinput="onCodeInput" maxlength="10" />
  </t-dialog>



  <!-- 争议弹窗 -->
  <t-dialog visible="{{showDisputeDialog}}" title="发起争议" confirm-btn="确认提交" cancel-btn="取消" bind:confirm="onConfirmDispute" bind:cancel="onCloseDisputeDialog">
    <input slot="content" class="dispute-input" placeholder="请描述争议原因" value="{{disputeReason}}" bindinput="onDisputeReasonInput" />
  </t-dialog>

  <!-- 评价弹窗 -->
  <t-dialog visible="{{showReviewDialog}}" title="评价订单" confirm-btn="提交评价" cancel-btn="取消" bind:confirm="onSubmitReview" bind:cancel="onCloseReviewDialog">
    <view slot="content" class="review-dialog-content">
      <view class="review-row">
        <text class="review-label">评分</text>
        <picker mode="selector" range="{{[1,2,3,4,5]}}" value="{{reviewRating - 1}}" bindchange="onRatingChange">
          <view class="review-picker">{{reviewRating}} 星</view>
        </picker>
      </view>
      <textarea class="review-textarea" placeholder="请输入评价内容" value="{{reviewContent}}" bindinput="onReviewInput" maxlength="200" />
      <view class="review-images">
        <image wx:for="{{reviewImages}}" wx:key="*this" src="{{item}}" class="review-thumb" data-index="{{index}}" bindtap="onRemoveReviewImage" />
        <view wx:if="{{reviewImages.length < maxReviewImages}}" class="review-add" bindtap="onChooseReviewImage">+</view>
      </view>
    </view>
  </t-dialog>
</view>
