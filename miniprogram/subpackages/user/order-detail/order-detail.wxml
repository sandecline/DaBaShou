<view class="order-detail-page">
  <t-loading wx:if="{{loading}}" theme="circular" size="40px" text="加载中..." />
  <view wx:elif="{{loadError}}" class="error-wrap">
    <text class="error-text">加载失败</text>
    <t-button size="small" bindtap="loadDetail">重试</t-button>
  </view>

  <view wx:elif="{{order}}" class="detail-content">
    <!-- 状态标签 -->
    <view class="status-bar">
      <t-tag theme="{{statusTheme}}" size="large">{{ORDER_STATUS_MAP[order.status]}}</t-tag>
    </view>

    <!-- 订单信息 -->
    <t-cell-group bordered>
      <t-cell title="订单号" note="{{order.orderNo}}" />
      <t-cell title="服务标题" note="{{order.shelfTitle}}" />
      <t-cell title="积分金额" note="{{order.pointAmount}} 积分" />
      <t-cell title="分类" note="{{order.skillTagName}}" />
      <t-cell title="创建时间" note="{{order.createTime}}" />
    </t-cell-group>

    <!-- 对方信息 -->
    <t-cell-group bordered>
      <t-cell title="{{order.myRole === 'seller' ? '买家' : '卖家'}}" note="{{order.myRole === 'seller' ? order.buyerNickname : order.sellerNickname}}" />
    </t-cell-group>

    <!-- ====== Status 1: 待核销 — 启动核销码 ====== -->
    <view wx:if="{{order.status === 1}}" class="code-section">
      <view class="section-title">启动服务核销码</view>
      <view class="code-row">
        <view class="code-box">
          <text class="code-label">我的核销码</text>
          <text class="code-text">{{order.myRole === 'buyer' ? order.buyerVerifyCode : order.sellerVerifyCode}}</text>
        </view>
        <view class="code-box">
          <text class="code-label">对方核销码</text>
          <text class="code-text">{{order.myRole === 'buyer' ? order.sellerVerifyCode : order.buyerVerifyCode}}</text>
        </view>
      </view>
      <view class="code-hint">双方均输入对方的核销码后，订单进入服务中状态</view>
      <view class="verify-status">
        <text>我方：{{(order.myRole === 'buyer' ? order.buyerVerified : order.sellerVerified) ? '已核销' : '待核销'}}</text>
        <text>对方：{{(order.myRole === 'buyer' ? order.sellerVerified : order.buyerVerified) ? '已核销' : '待核销'}}</text>
      </view>
    </view>

    <!-- ====== Status 3: 服务中 — 确认核销码 ====== -->
    <view wx:if="{{order.status === 3}}" class="code-section">
      <view class="section-title">完成服务核销码</view>
      <view class="code-row">
        <view class="code-box">
          <text class="code-label">我的确认码</text>
          <text class="code-text">{{order.myRole === 'buyer' ? order.buyerConfirmCode : order.sellerConfirmCode}}</text>
        </view>
        <view class="code-box">
          <text class="code-label">对方确认码</text>
          <text class="code-text">{{order.myRole === 'buyer' ? order.sellerConfirmCode : order.buyerConfirmCode}}</text>
        </view>
      </view>
      <view class="code-hint">双方均输入对方的确认码后，订单完成并结算积分</view>
      <view class="verify-status">
        <text>我方：{{(order.myRole === 'buyer' ? order.buyerConfirmed : order.sellerConfirmed) ? '已确认' : '待确认'}}</text>
        <text>对方：{{(order.myRole === 'buyer' ? order.sellerConfirmed : order.buyerConfirmed) ? '已确认' : '待确认'}}</text>
      </view>
    </view>

    <!-- 退款提示 -->
    <view wx:if="{{order.refundRequesting}}" class="refund-banner">
      <t-icon name="error-circle" size="40rpx" color="#FF6E14" />
      <text>{{order.refundRequester === order.myRole ? '你' : (order.refundRequester === 'buyer' ? '买家' : '卖家')}}已发起退款申请</text>
    </view>

    <!-- 时间线 -->
    <view wx:if="{{order.serviceStartTime}}" class="timeline">
      <text class="timeline-item">开始: {{order.serviceStartTime}}</text>
      <text wx:if="{{order.completeTime}}" class="timeline-item">完成: {{order.completeTime}}</text>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view wx:if="{{order}}" class="bottom-actions">
    <!-- Status 1: 输入对方核销码启动服务 -->
    <t-button wx:if="{{order.status === 1}}" theme="primary" size="large" block loading="{{actionLoading}}" bindtap="onCodeBtnTap" data-title="输入对方的核销码" data-action="start">核销启动服务</t-button>

    <!-- Status 3: 输入对方确认码完成服务 -->
    <t-button wx:if="{{order.status === 3}}" theme="primary" size="large" block loading="{{actionLoading}}" bindtap="onCodeBtnTap" data-title="输入对方的确认码" data-action="complete">核销完成服务</t-button>

    <!-- Status 3/5: 争议 -->
    <t-button wx:if="{{order.status === 3 || order.status === 5}}" theme="warning" size="large" block loading="{{actionLoading}}" bindtap="onShowDisputeDialog">发起争议</t-button>

    <!-- Status 3: 退款（双向同意） -->
    <t-button wx:if="{{order.status === 3}}" theme="light" size="large" block loading="{{actionLoading}}" bindtap="onShowRefundDialog">
      {{order.refundRequesting ? (order.refundRequester === order.myRole ? '等待对方同意退款' : '点击同意退款') : '申请退款'}}
    </t-button>

    <!-- Status 1: 取消 -->
    <t-button wx:if="{{order.status === 1}}" theme="default" size="large" block loading="{{actionLoading}}" bindtap="onShowCancelDialog">取消订单</t-button>
  </view>

  <!-- 核销码弹窗 -->
  <t-dialog visible="{{showCodeDialog}}" title="{{codeDialogTitle}}" confirm-btn="确认" cancel-btn="取消" bind:confirm="onConfirmCode" bind:cancel="onCloseCodeDialog">
    <input slot="content" class="code-input" placeholder="请输入核销码" value="{{codeInput}}" bindinput="onCodeInput" maxlength="10" />
  </t-dialog>

  <!-- 取消弹窗 -->
  <t-dialog visible="{{showCancelDialog}}" title="取消订单" confirm-btn="确认取消" cancel-btn="再想想" bind:confirm="onConfirmCancel" bind:cancel="onCloseCancelDialog">
    <input slot="content" class="cancel-input" placeholder="取消原因（可选）" value="{{cancelReason}}" bindinput="onCancelReasonInput" />
  </t-dialog>

  <!-- 争议弹窗 -->
  <t-dialog visible="{{showDisputeDialog}}" title="发起争议" confirm-btn="确认提交" cancel-btn="取消" bind:confirm="onConfirmDispute" bind:cancel="onCloseDisputeDialog">
    <input slot="content" class="dispute-input" placeholder="请描述争议原因" value="{{disputeReason}}" bindinput="onDisputeReasonInput" />
  </t-dialog>
</view>
