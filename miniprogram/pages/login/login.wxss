/* 登录页样式 */

.page-login {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* ===== 导航栏 ===== */
.nav-bar {
  padding: 0 24rpx;
  padding-top: env(safe-area-inset-top);
  height: calc(88rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

/* ===== Logo 区域 ===== */
.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 80rpx;
}

.logo-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #0052d9 0%, #2979FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 82, 217, 0.3);
}

.logo-text {
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: "PingFang SC", "Noto Sans SC", sans-serif;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.app-desc {
  font-size: 26rpx;
  color: #999;
}

/* ===== 登录表单 ===== */
.login-form {
  margin: 0 48rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.input-group {
  display: flex;
  align-items: center;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
  margin-bottom: 28rpx;
  background: #fafafa;
  transition: border-color 0.2s;
}

.input-group:focus-within {
  border-color: #0052d9;
  background: #ffffff;
}

.input-icon {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  color: #333;
}

.form-input::placeholder {
  color: #ccc;
}

.eye-btn {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 登录按钮 ===== */
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #0052d9 0%, #2979FF 100%);
  border: none;
  border-radius: 16rpx;
  margin-top: 8rpx;
  letter-spacing: 8rpx;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.6;
}

/* ===== 测试账号提示 ===== */
.test-hint {
  margin: 60rpx 48rpx 0;
  text-align: center;
}

.hint-title {
  font-size: 24rpx;
  color: #bbb;
  display: block;
  margin-bottom: 20rpx;
}

.hint-accounts {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.hint-account {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 82, 217, 0.06);
  border: 1rpx solid rgba(0, 82, 217, 0.15);
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}

.hint-user {
  font-size: 22rpx;
  color: #0052d9;
  font-weight: 500;
}

.hint-pwd {
  font-size: 22rpx;
  color: #999;
}
