<!-- 发布技能表单 -->
<view class="page">
  <!-- 分类选择区 -->
  <view class="section card">
    <text class="section-title">服务分类</text>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-item {{categoryIndex === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onCategoryTap"
      >
        <text class="category-icon">{{item._icon}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
    <view class="tag-row" wx:if="{{tags.length > 0}}">
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="tag-item {{tagIndex === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onTagTap"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 基本信息区 -->
  <view class="section card">
    <text class="section-title">基本信息</text>

    <!-- 标题 -->
    <view class="form-item">
      <view class="form-header">
        <text class="form-label">服务标题 <text class="required">*</text></text>
        <text class="char-count">{{titleLength}}/50</text>
      </view>
      <t-input
        placeholder="例如：辅导高等数学期末考试"
        value="{{title}}"
        maxlength="{{50}}"
        clearable
        bind:change="onTitleInput"
      />
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <view class="form-header">
        <text class="form-label">服务描述 <text class="required">*</text></text>
        <text class="char-count {{descLength > 500 ? 'over-limit' : ''}}">{{descLength}}/500</text>
      </view>
      <t-textarea
        placeholder="详细描述你能提供的服务内容、范围和经验..."
        value="{{description}}"
        maxlength="{{500}}"
        autosize
        bind:change="onDescInput"
      />
    </view>

    <!-- 积分价格 -->
    <view class="form-item">
      <text class="form-label">积分价格 <text class="required">*</text></text>
      <t-input
        type="number"
        placeholder="每单收取的积分数"
        value="{{pointPrice}}"
        suffix="积分"
        bind:change="onPriceInput"
      />
    </view>

    <!-- 预计时长 -->
    <view class="form-item">
      <text class="form-label">预计时长 <text class="required">*</text></text>
      <t-input
        type="number"
        placeholder="完成一次服务需要的时间"
        value="{{durationMinutes}}"
        suffix="分钟"
        bind:change="onDurationInput"
      />
    </view>
  </view>

  <!-- 服务方式 -->
  <view class="section card">
    <text class="section-title">服务方式</text>
    <t-radio-group value="{{locationType}}" bind:change="onLocationChange">
      <view class="radio-row">
        <t-radio value="{{1}}" label="线上" />
        <t-radio value="{{2}}" label="线下" />
        <t-radio value="{{3}}" label="均可" />
      </view>
    </t-radio-group>
  </view>

  <!-- 空闲时间 -->
  <view class="section card">
    <text class="section-title">空闲时间（选填）</text>
    <text class="section-desc">设置你可以提供服务的具体时段，方便同学选择</text>

    <!-- 已有时段列表 -->
    <view wx:if="{{timeSlots.length > 0}}" class="timeslot-list">
      <view
        wx:for="{{timeSlots}}"
        wx:key="index"
        class="timeslot-row"
      >
        <view class="timeslot-info">
          <t-icon name="time" size="32rpx" color="#0052d9" />
          <text class="timeslot-text">{{item.date}} {{item.startTime}}-{{item.endTime}}</text>
        </view>
        <view class="timeslot-remove" data-index="{{index}}" catchtap="onRemoveTimeSlot">
          <t-icon name="delete" size="36rpx" color="#d54941" />
        </view>
      </view>
    </view>

    <!-- 添加新时段 -->
    <view wx:if="{{addingTimeSlot}}" class="timeslot-editor">
      <view class="timeslot-pickers">
        <picker
          class="timeslot-picker-item"
          mode="date"
          start="{{todayStr}}"
          value="{{newSlotDate}}"
          bindchange="onSlotDateChange"
        >
          <view class="picker-value picker-value-sm">{{newSlotDate || '选择日期'}}</view>
        </picker>
        <view class="timeslot-sep">—</view>
        <picker
          class="timeslot-picker-item"
          mode="time"
          value="{{newSlotStart}}"
          bindchange="onSlotStartChange"
        >
          <view class="picker-value picker-value-sm">{{newSlotStart || '开始'}}</view>
        </picker>
        <view class="timeslot-sep">~</view>
        <picker
          class="timeslot-picker-item"
          mode="time"
          value="{{newSlotEnd}}"
          bindchange="onSlotEndChange"
        >
          <view class="picker-value picker-value-sm">{{newSlotEnd || '结束'}}</view>
        </picker>
      </view>
      <view class="timeslot-actions">
        <t-button theme="primary" size="small" bindtap="onConfirmTimeSlot">确认添加</t-button>
        <t-button theme="default" size="small" bindtap="onCancelTimeSlot">取消</t-button>
      </view>
    </view>

    <view wx:else class="timeslot-add-row">
      <t-button theme="default" size="small" icon="add" bindtap="onShowTimeSlotEditor">
        添加时段
      </t-button>
    </view>
  </view>

  <!-- 图片上传 -->
  <view class="section card">
    <text class="section-title">服务图片（选填）</text>
    <view class="image-list">
      <block wx:for="{{images}}" wx:key="*this">
        <view class="image-item" data-index="{{index}}" bindtap="onPreviewImage">
          <t-image src="{{item}}" mode="aspectFill" class="upload-image" />
          <view class="image-remove" data-index="{{index}}" catchtap="onRemoveImage">
            <t-icon name="close" size="28rpx" color="#fff" />
          </view>
        </view>
      </block>
      <view
        wx:if="{{images.length < maxImages}}"
        class="image-add"
        bindtap="onChooseImage"
      >
        <t-icon name="add" size="48rpx" color="#c9cdd4" />
        <text class="add-text">{{images.length}}/{{maxImages}}</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-wrap">
    <t-button
      theme="primary"
      size="large"
      block
      loading="{{submitting}}"
      bindtap="onSubmit"
    >{{submitting ? '发布中...' : '立即发布'}}</t-button>
  </view>
</view>
